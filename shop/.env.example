# ----- Base ------------------------------------------------------------------
# URL publique du site (utilisee pour les redirects OAuth et PayPal).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- Base de donnees -------------------------------------------------------
# SQLite pour le developpement local. En prod, pointer vers Postgres:
#   DATABASE_URL="postgresql://user:pass@host:5432/frzrp"
# et changer provider dans prisma/schema.prisma en "postgresql".
DATABASE_URL="file:./dev.db"

# ----- Session ---------------------------------------------------------------
# Secret pour signer les cookies de session (JWT HS256). Generer avec:
#   openssl rand -base64 32
SESSION_SECRET="change-me-please-use-openssl-rand-base64-32"

# ----- Discord OAuth ---------------------------------------------------------
# Creer une application sur https://discord.com/developers/applications
# Redirect URI a configurer: <NEXT_PUBLIC_APP_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ----- PayPal (mode sandbox par defaut) --------------------------------------
# Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# Basculer PAYPAL_MODE="live" une fois les identifiants de prod obtenus.
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# ----- Integration FiveM -----------------------------------------------------
# Token partage entre le site et la resource FiveM QBCore pour autoriser les
# appels /api/fivem/*. Generer avec: openssl rand -hex 32
FIVEM_API_TOKEN="change-me-shared-secret-between-site-and-fivem"

# ----- Seed admin (optionnel) ------------------------------------------------
# Discord ID (snowflake numerique) a promouvoir admin au demarrage.
# Pour recuperer son ID: activer le mode dev Discord > clic droit sur son profil > Copier l'ID.
ADMIN_DISCORD_ID=""
